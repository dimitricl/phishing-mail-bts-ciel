# Configuration Flask Phishing Mail
# Copier ce fichier en .env et remplir avec vos valeurs

# Secret key Flask (GÉNÉRER AVEC: python3 -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here

# Configuration SMTP
SMTP_SERVER=localhost
SMTP_PORT=1025

# URL de base pour les liens de tracking
BASE_URL=http://localhost:8080

# Dossier des templates
TEMPLATES_DIR=templates
